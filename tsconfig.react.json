// tsconfig.react.json

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "outDir": "./dist/react"
  },
  "include": [
    "src/react/**/*",
    "src/shared/**/*"
  ],
  "exclude": ["node_modules", "dist", "**/node_modules/**", "**/.pnpm/**"]
}
