{
  "name": "@convex-better-auth/package",
  "version": "0.1.3",
  "description": "Reusable Better Auth + Convex authentication package with email & password features",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./react/client": "./src/react/client/index.ts",
    "./react/client/base": "./src/react/client/components/base/index.ts",
    "./react/client/forms": "./src/react/client/components/forms/index.ts",
    "./solid": "./src/solid/index.ts",
    "./solid/client": "./src/solid/client/index.ts",
    "./solid/client/forms": "./src/solid/client/components/forms/index.ts",
    "./solid/client/base": "./src/solid/client/components/base/index.ts",
    "./shared": "./src/shared/index.ts"
  },
  "scripts": {
    "build": "pnpm build:types",
    "build:types": "pnpm build:types:react && pnpm build:types:solid",
    "build:types:react": "tsc -p tsconfig.react.json",
    "build:types:solid": "tsc -p tsconfig.solid.json",
    "lint": "echo \"No linter configured yet\"",
    "type-check": "pnpm type-check:react && pnpm type-check:solid",
    "type-check:react": "tsc -p tsconfig.react.json --noEmit",
    "type-check:solid": "tsc -p tsconfig.solid.json --noEmit",
    "typecheck": "pnpm type-check",
    "error": "pnpm type-check && pnpm lint",
    "diagnostics": "pnpm type-check && pnpm lint",
    "storybook": "pnpm storybook:react",
    "storybook:react": "storybook dev -p 6008 --config-dir .storybook-react",
    "storybook:solid": "storybook dev -p 6009 --config-dir .storybook-solid",
    "build-storybook": "pnpm build-storybook:react && pnpm build-storybook:solid",
    "build-storybook:react": "storybook build --config-dir .storybook-react -o storybook-static-react",
    "build-storybook:solid": "storybook build --config-dir .storybook-solid -o storybook-static-solid"
  },
  "dependencies": {
    "@tanstack/react-form": "^1.27.7",
    "@tanstack/solid-form": "^1.27.7",
    "@tanstack/zod-form-adapter": "^0.42.1",
    "zod": "^4.3.5"
  },
  "peerDependencies": {
    "@better-auth/oauth-provider": "^1.4.13",
    "@convex-dev/better-auth": "^0.10.10",
    "@convex-dev/resend": "^0.2.0",
    "@react-email/components": "0.5.0",
    "@tanstack-app/ui": "*",
    "@tanstack/react-router": "^1.150.0",
    "@tanstack/solid-router": "^1.150.0",
    "better-auth": "^1.4.13",
    "convex": "^1.31.5",
    "lucide-react": "^0.562.0",
    "lucide-solid": "^0.562.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-qr-code": "^2.0.0",
    "solid-js": "^1.9.0",
    "solid-qr-code": "^0.1.11",
    "solid-sonner": "^0.2.8"
  },
  "peerDependenciesMeta": {
    "@tanstack-app/ui": {
      "optional": true
    },
    "@tanstack/react-router": {
      "optional": true
    },
    "@tanstack/solid-router": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "lucide-solid": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-hot-toast": {
      "optional": true
    },
    "react-qr-code": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "solid-qr-code": {
      "optional": true
    },
    "solid-sonner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@better-auth/oauth-provider": "^1.4.13",
    "@hookform/resolvers": "^5.2.2",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.15",
    "@storybook/react": "^8.6.15",
    "@storybook/react-vite": "^8.6.15",
    "@tanstack-app/ui": "file:../ui",
    "@types/node": "^25.0.9",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.23",
    "lucide-react": "^0.562.0",
    "lucide-solid": "^0.562.0",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-qr-code": "^2.0.18",
    "solid-js": "^1.9.10",
    "solid-qr-code": "^0.1.11",
    "solid-sonner": "^0.2.8",
    "storybook": "^8.6.15",
    "storybook-solidjs": "1.0.0-beta.7",
    "storybook-solidjs-vite": "1.0.0-beta.7",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "better-auth",
    "convex",
    "authentication",
    "email-password",
    "2fa",
    "oauth"
  ],
  "author": "",
